"""
Shared L-System driver for Envy, UFO, and future trellis architectures.
Configure via extern variables passed to Lsystem(..., variables).
"""
import os
import sys
from pathlib import Path
import numpy as np


# Ensure repository root is importable regardless of working directory
CURRENT_DIR = os.path.dirname(__file__)
if CURRENT_DIR not in sys.path:
    sys.path.append(CURRENT_DIR)
TREE_BASE_DIR = Path(__file__).resolve().parents[1] / "tree_models" / "base_tree"
if TREE_BASE_DIR not in sys.path:
    sys.path.append(str(TREE_BASE_DIR))

from lpy_treesim.lpy_functions.lpy_helper_functions import start_each_common, end_each_common, resolve_attr

# -----------------------------------------------------------------------------
# EXTERNALLY CONFIGURABLE PATHS
# -----------------------------------------------------------------------------
# Override these externs via Lsystem(..., variables) to point at a specific
# architecture without editing this shared file.
extern(
  color_manager = None,
  prototype_builder_path = "tree_models.Envy.Envy_prototypes.build_basicwood_prototypes",
  trunk_class_path = "tree_models.Envy.Envy_prototypes.Trunk",
  simulation_config_class_path = "tree_models.Envy.Envy_simulation.EnvySimulationConfig",
  simulation_class_path = "tree_models.Envy.Envy_simulation.EnvySimulation",
  branch_hierarchy = {},
  seed_value = None,
)

# Resolve extern-provided dotted paths so the rest of the script can operate on
# concrete classes/functions exactly like the Envy/UFO drivers do.

# Generator
lpy_rng = np.random.default_rng(seed=seed_value)

# Wood and simulation classes
#   Note that these will point to, eg, UFO or Envy, as specified in the extern paths

# Create instances of the simulation and trunk variables
SimulationConfigClass = resolve_attr(simulation_config_class_path)
SimulationClass = resolve_attr(simulation_class_path)
simulation_config = SimulationConfigClass(seed=seed_value)
tree_sim = SimulationClass(simulation_config)

prototype_builder_fn = resolve_attr(prototype_builder_path)
basicwood_prototypes = prototype_builder_fn(lpy_rng=lpy_rng, sim_config=simulation_config)
Trunk = resolve_attr(trunk_class_path)

# Create the main trunk
main_trunk = Trunk(basicwood_prototypes['trunk'])

# Build trellis geometry and attractor grids.
trellis_support = tree_sim.support

# Track parent/child relationships for tying/pruning decisions.
branch_hierarchy["root"] = [main_trunk]
# branch_hierarchy: dict[str, list] maps parent name to list of child branch objects
# parent_map: dict[str, str] maps child name to parent name for O(1) parent lookup during pruning
# The branch_hierarchy dictionary is also parsed in tree_builder.export_hierarchy_dict to create the
#   skeleton and branch id names
parent_map = {}  # Internal bookkeeping for efficient parent lookup
branch_hierarchy[main_trunk.name] = []


# L-Py callbacks delegate to the Python helpers so architectures share logic.
def StartEach(lstring):
  """Proxy to shared tying preparation logic."""
  start_each_common(lstring, branch_hierarchy, tree_sim, main_trunk)


def EndEach(lstring):
  """Proxy to shared tying/pruning orchestration logic."""
  return end_each_common(
    lstring,
    branch_hierarchy,
    tree_sim,
    simulation_config,
    main_trunk,
    getIterationNb,
  )

generalized_cylinder = getattr(simulation_config, "use_generalized_cylinder", True)

# =============================================================================
# L-SYSTEM GRAMMAR DEFINITION
# =============================================================================
# This section defines the formal grammar for the tree growth simulation.
# The L-System uses modules (symbols) to represent different plant components
# and their growth behaviors.

# -----------------------------------------------------------------------------
# MODULE DECLARATIONS
# -----------------------------------------------------------------------------
# Define the vocabulary of symbols used in the L-System grammar.
# Each module represents a different type of plant component or operation.
# WoodStart is a marker in the string that is used in the "tie" method in the simulation to identify where to put the tying curve
module Attractors     # Trellis support structure that guides branch growth
module grow_object(plant_segment, hierarchy)    # Growing plant parts (trunk, branches, spurs) with length/thickness and hierarchy dict
module bud_site(plant_segment, hierarchy)       # Adding a bud site along a branch
module bud(bud_parameters, hierarchy)           # Dormant buds that can break to produce new branches with hierarchy dict
module branch        # Branch segments in the L-System string
module BudStart      # Starting point of a bud
module WoodStart     # Starting point of wood segments (used for tying operations)
module trunk
# -----------------------------------------------------------------------------
# GLOBAL L-SYSTEM PARAMETERS
# -----------------------------------------------------------------------------
# Create a growth guide curve for the initial trunk development
trunk_guide_curve = main_trunk.growth_guide_curve()

# -----------------------------------------------------------------------------
# AXIOM (STARTING STRING)
# -----------------------------------------------------------------------------
# The initial L-System string that begins the simulation.
# Starts with the trellis attractors, sets up the trunk guide curve,
# and initializes the trunk growth with proper orientation and hierarchy dict.
Axiom: Attractors(trellis_support)+(main_trunk.angle_wrt_ground())Trunk(branch_hierarchy)

# -----------------------------------------------------------------------------
# DERIVATION PARAMETERS
# -----------------------------------------------------------------------------
# Set the maximum number of derivation steps for the L-System
derivation length: simulation_config.derivation_length

# -----------------------------------------------------------------------------
# PRODUCTION RULES
# -----------------------------------------------------------------------------
# Define how each module type evolves during each derivation step.
# These rules control the growth, branching, and development of the tree.

production:

trunk(hierarchy):
  print(f"In trunk {generalized_cylinder}")
  nproduce[
  nproduce SetGuide(trunk_guide_curve, main_trunk.growth.max_length)
  if generalized_cylinder:
    nproduce @Gc
  nproduce GetPos(main_trunk.location.start)
  nproduce GetHead(main_trunk.location.start_dir)
  nproduce WoodStart(ParameterSet(type = main_trunk))
  # nproduce grow_object(main_trunk, hierarchy)
  nproduce GetPos(main_trunk.location.end)
  nproduce GetHead(main_trunk.location.end_dir)
  nproduce GetLeft(main_trunk.location.end_left_dir)
  if generalized_cylinder:
    nproduce @Ge
  produce ]

# -----------------------------------------------------------------------------
# GEOMETRIC INTERPRETATION (HOMOMORPHISM)
# -----------------------------------------------------------------------------
interpretation:
I(s,r,o):
  produce I(s,o.growth.diameter,o) F(s, o.growth.diameter)

S(a,r,o):
  # Map abstract L-System modules to concrete 3D geometry for rendering.
  produce F(a, r)

# -----------------------------------------------------------------------------
# ATTRACTOR VISUALIZATION
# -----------------------------------------------------------------------------
# Additional production rules for displaying trellis attractor points
production:
Attractors(trellis_support):
  # Display enabled attractor points as visual markers
  trellis_support.check_valid()
  points_to_display = trellis_support.attractor_grid.get_enabled_points()
  if len(points_to_display) > 0:
    produce [,(3) @g(PointSet(points_to_display,width=simulation_config.attractor_point_width))]

