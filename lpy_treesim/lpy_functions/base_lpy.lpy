"""
Shared L-System driver for Envy, UFO, and future trellis architectures.
Configure via extern variables passed to Lsystem(..., variables).
"""
import os
import sys
from pathlib import Path
import numpy as np


# Ensure repository root is importable regardless of working directory
CURRENT_DIR = os.path.dirname(__file__)
if CURRENT_DIR not in sys.path:
    sys.path.append(CURRENT_DIR)
TREE_BASE_DIR = Path(__file__).resolve().parents[1] / "tree_models" / "base_tree"
if TREE_BASE_DIR not in sys.path:
    sys.path.append(str(TREE_BASE_DIR))

from lpy_treesim.lpy_functions.lpy_helper_functions import start_each_common, end_each_common, resolve_attr

# -----------------------------------------------------------------------------
# EXTERNALLY CONFIGURABLE PATHS
# -----------------------------------------------------------------------------
# Override these externs via Lsystem(..., variables) to point at a specific
# architecture without editing this shared file.
extern(
  color_manager = None,
  prototype_builder_path = "tree_models.Envy.Envy_prototypes.build_basicwood_prototypes",
  trunk_class_path = "tree_models.Envy.Envy_prototypes.Trunk",
  simulation_config_class_path = "tree_models.Envy.Envy_simulation.EnvySimulationConfig",
  simulation_class_path = "tree_models.Envy.Envy_simulation.EnvySimulation",
  branch_hierarchy = {},
  interactive = False,
  seed_value = None,
)

# Resolve extern-provided dotted paths so the rest of the script can operate on
# concrete classes/functions exactly like the Envy/UFO drivers do.

# Generator
lpy_rng = np.random.default_rng(seed=seed_value)

# Wood and simulation classes
#   Note that these will point to, eg, UFO or Envy, as specified in the extern paths

# Create instances of the simulation and trunk variables
SimulationConfigClass = resolve_attr(simulation_config_class_path)
SimulationClass = resolve_attr(simulation_class_path)
simulation_config = SimulationConfigClass(seed=seed_value)
tree_sim = SimulationClass(simulation_config)

prototype_builder_fn = resolve_attr(prototype_builder_path)
basicwood_prototypes = prototype_builder_fn(lpy_rng=lpy_rng, sim_config=simulation_config)
Trunk = resolve_attr(trunk_class_path)

# Create the main trunk
# TODO call as many times as there are trunks
# Create a growth guide curve for the initial trunk development
main_trunk = Trunk(basicwood_prototypes['trunk'])
trunk_guide_curve = main_trunk.growth_guide_curve()

# Build trellis geometry and attractor grids.
trellis_support = tree_sim.support

# Track parent/child relationships for tying/pruning decisions.
# Format: Name->list of bud children
branch_hierarchy["root"] = [main_trunk]
branch_hierarchy[main_trunk.name] = []

# L-Py callbacks delegate to the Python helpers so architectures share logic.
def StartEach(lstring):
  """Proxy to shared tying preparation logic."""
  if tree_sim.current_iteration >= simulation_config.derivation_length - 2:
    # Simulation ending - generate the cylinders
    print("Starting geometry")
    tree_sim.generate_geometry = True
  start_each_common(lstring, branch_hierarchy, tree_sim)


def EndEach(lstring):
  """Proxy to shared tying/pruning orchestration logic."""
  return end_each_common(lstring,
                         branch_hierarchy,
                         tree_sim,
                         getIterationNb)

# =============================================================================
# L-SYSTEM GRAMMAR DEFINITION
# =============================================================================
# This section defines the formal grammar for the tree growth simulation.
# The L-System uses modules (symbols) to represent different plant components
# and their growth behaviors.

# -----------------------------------------------------------------------------
# MODULE DECLARATIONS
# -----------------------------------------------------------------------------
# Define the vocabulary of symbols used in the L-System grammar.
# Each module represents a different type of plant component or operation.
# WoodStart and BudStart are markers in the string that are used in the "tie"  and
#  prune methods in the simulation to identify where to put the tying curve/prune
module Attractors     # Trellis support structure that guides branch growth
module grow_object(plant_segment)    # Growing plant parts (trunk, branches, spurs) with length/thickness and hierarchy dict
module bud_site(plant_segment)       # Adding a bud site along a branch
module add_bud(bud_parameter)        # Dormant buds that can break to produce new branches with hierarchy dict
module add_branch(plant_segment)     # Adds a trunk/branch/spur
module BudStart      # Starting point of a bud
module WoodStart     # Starting point of wood segments (used for tying operations)
# Geometry creation
module make_cylinders(plant_segment)
module make_bud(bud)
# -----------------------------------------------------------------------------
# GLOBAL L-SYSTEM PARAMETERS
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AXIOM (STARTING STRING)
# -----------------------------------------------------------------------------
# The initial L-System string that begins the simulation.
# Starts with the trellis attractors, sets up the trunk guide curve,
# and initializes the trunk growth with proper orientation and hierarchy dict.
Axiom: Attractors(trellis_support)&(main_trunk.angle_wrt_ground())add_branch(main_trunk, trunk_guide_curve)

# -----------------------------------------------------------------------------
# DERIVATION PARAMETERS
# -----------------------------------------------------------------------------
# Set the maximum number of derivation steps for the L-System
derivation length: simulation_config.derivation_length

# -----------------------------------------------------------------------------
# PRODUCTION RULES
# -----------------------------------------------------------------------------
# Define how each module type evolves during each derivation step.
# These rules control the growth, branching, and development of the tree.

production:
# Put a branch/trunk in the string
add_branch(plant_segment, guide_curve):
  nproduce[
  # These grab the current turtle position and heading; for use in tie downs
  nproduce GetPos(plant_segment.location.start)
  nproduce GetHead(plant_segment.location.start_dir)
  nproduce GetLeft(plant_segment.location.start_left_dir)
  # This just places a marker in the string so we can cut it out later when pruning/adding a guide curve
  WoodStart(ParameterSet(type=plant_segment, name=plant_segment.name))
  if guide_curve:
    nproduce SetGuide(guide_curve, plant_segment.growth.prune_length)
  # This will (eventually) make geometry
  nproduce make_cylinders(plant_segment)
  # This is the main recursive call; it will keep calling itself until the max branch length is reached
  nproduce grow_object(plant_segment)
  # This is suppose to capture the end location of the branch; warning that it's not always accurate
  nproduce GetPos(plant_segment.location.end)
  nproduce GetHead(plant_segment.location.end_dir)
  nproduce GetLeft(plant_segment.location.end_left_dir)
  produce]


# This will either generate the geometry (last iteration) or just place hold where the geometry goes
make_cylinders(plant_segment):
  #  print(f"Making cylinders for {plant_segment.name} Length {plant_segment.growth.length} step {plant_segment.config.cylinder_length}", end="")
  if tree_sim.generate_geometry:
    # Instance-level labeling, unique color per branch instance
    r, g, b = color_manager.get_unique_color(plant_segment.name)
    nproduce SetColor(r, g, b)
    contour = plant_segment.contour_curve()
    if contour is not None:
      nproduce SetContour(contour)
    start_diameter = plant_segment.growth.get_start_diameter()
    end_diameter = plant_segment.growth.get_end_diameter()
    nproduce[
    nproduce I(plant_segment, plant_segment.config.cylinder_length, start_diameter, end_diameter)
    produce]
  else:
    # Just keep putting this symbol back in the string
    produce make_cylinders(plant_segment)


# This will either generate the geometry (last iteration) or just place hold where the geometry goes
make_bud(bud):
  #  print(f"Making cylinders for {plant_segment.name} Length {plant_segment.growth.length} step {plant_segment.config.cylinder_length}", end="")
  if tree_sim.generate_geometry:
    # Instance-level labeling, unique color per branch instance
    r, g, b = color_manager.get_unique_color(bud.name)
    nproduce SetColor(r, g, b)
    start_diameter = plant_segment.growth.get_start_diameter()
    end_diameter = plant_segment.growth.get_end_diameter()
    produce IBud(bud.length, bud.start_diameter(), bud.end_diameter)
  else:
    # Just keep putting this symbol back in the string
    produce make_bud(bud)


# BUD SITE PRODUCTION RULE
# Controls placing bud sites along a branch
# See bud_break below for when a bud actually transitions into branch or spur
bud_site(bud_parameters):
  # Bud break condition met - create new branch
  new_bud = bud_parameters.type.add_bud_site()
  if new_bud == None:
    # Bud creation failed - terminate - this shouldn't happen...
    produce *
  # Register new branch in parent-child relationship tracking
  branch_hierarchy[new_bud.name] = []  # Initialize empty children list for new branch
  branch_hierarchy[bud_parameters.type.name].append(new_bud)  # Add to parent's children
  nproduce [
  # Put the bud in the string - Next iteration will determine if the bud produces a branch
  # Labeling with BudStart so we can find it again
  nproduce GetPos(new_bud.start_loc)
  nproduce GetHead(new_bud.start_dir)
  # Marker in the string
  nproduce BudStart(ParameterSet(type=new_bud, name=new_bud.name))
  nproduce bud(ParameterSet(type=new_bud, name=new_bud.name))
  produce ]


# GROWTH PRODUCTION RULE
# Handles: growing the branch length
#  1) Adding buds
#  2) Adding
grow_object(plant_segment):
  if plant_segment == None:
    # Null object - terminate this branch and generate cylinders
    produce *
  if plant_segment.growth.length > 1.1 * plant_segment.growth.prune_length:
    # Maximum length reached - stop growing this segment. Will be pruned anyways
    nproduce *
  else:
    # Continue growing - update segment properties
    # Update internal state of the plant segment
    plant_segment.grow()
    # Update physical representation
    # Produce bud (after all cylinders in this growth step)
    if plant_segment.pre_bud_rule(plant_segment, simulation_config):
      for generated in plant_segment.post_bud_rule(plant_segment, simulation_config):
        nproduce new(generated[0], *generated[1])
    if plant_segment.is_add_bud_site():
        # Age-based bud production for lateral branching - add bud site
        # First move the turtle along by the distance since the last bud
        nproduce f(plant_segment.growth_since_last_bud())
        # Now add bud
        nproduce bud_site(ParameterSet(type=plant_segment, name=plant_segment.name))
        if plant_segment.post_bud_rule(plant_segment, simulation_config):
          for generated in plant_segment.post_bud_rule(plant_segment, simulation_config):
            nproduce new(generated[0], *generated[1])
    # Continue growing
    produce grow_object(plant_segment)


# -----------------------------------------------------------------------------
# GEOMETRIC INTERPRETATION (HOMOMORPHISM)
#  This only gets called in the interpolation step (called in tree builder) to create
#  geometry. So you will not see F's in the string when you print it out
#  Note: Not using generalized cylinders because we are going to manually stitch the
#   mesh cylinders together anyways. We do want to control the tapering and the
#   step size along the cylinders
# -----------------------------------------------------------------------------
interpretation:

I(plant_segment, step, start_diameter, end_diameter):
  n_cylinders = int(plant_segment.growth.length / plant_segment.config.cylinder_length)
  if n_cylinders < 1:
    n_cylinders = 1
  step_along = plant_segment.growth.length / n_cylinders
  delta_t = 1.0 / n_cylinders
  # At each cylinder, advance the turtle along step_along and change the diameter
  for i in range(n_cylinders):
    t = i * delta_t
    diameter = (1.0 - t) * start_diameter + t * end_diameter
    nproduce _(diameter) F(step_along)
  # Reset to base so the f.. methods work
  #loc = plant_segment.location.start
  #nproduce @M(loc[0], loc[1], loc[2])
  #h = plant_segment.location.start_dir
  #l = plant_segment.location.start_left_dir
  #produce @R(h[0], h[1], h[2], l[0], l[1], l[2])

IBud(length, start_diameter, end_diameter):
  nproduce[
  nproduce EndGuide
  nproduce _(start_diameter)
  nproduce F(length, end_diameter)
  nproduce]

# -----------------------------------------------------------------------------
# ATTRACTOR VISUALIZATION
# -----------------------------------------------------------------------------
# Additional production rules for displaying trellis attractor points
production:
Attractors(trellis_support):
  # Display enabled attractor points as visual markers
  trellis_support.check_valid()
  points_to_display = trellis_support.attractor_grid.get_enabled_points()
  if interactive and len(points_to_display) > 0:
    produce [,(3) @g(PointSet(points_to_display,width=simulation_config.attractor_point_width))]

