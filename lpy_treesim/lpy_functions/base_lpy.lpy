"""
Shared L-System driver for Envy, UFO, and future trellis architectures.
Configure via extern variables passed to Lsystem(..., variables).
"""
import os
import sys
from pathlib import Path
import numpy as np


# Ensure repository root is importable regardless of working directory
CURRENT_DIR = os.path.dirname(__file__)
if CURRENT_DIR not in sys.path:
    sys.path.append(CURRENT_DIR)
TREE_BASE_DIR = Path(__file__).resolve().parents[1] / "tree_models" / "base_tree"
if TREE_BASE_DIR not in sys.path:
    sys.path.append(str(TREE_BASE_DIR))

from lpy_treesim.lpy_functions.lpy_helper_functions import resolve_attr

# -----------------------------------------------------------------------------
# EXTERNALLY CONFIGURABLE PATHS
# -----------------------------------------------------------------------------
# Override these externs via Lsystem(..., variables) to point at a specific
# architecture without editing this shared file.
extern(
  color_manager = None,
  prototype_builder_path = "tree_models.Envy.Envy_prototypes.build_basicwood_prototypes",
  trunk_class_path = "tree_models.Envy.Envy_prototypes.Trunk",
  simulation_config_class_path = "tree_models.Envy.Envy_simulation.EnvySimulationConfig",
  simulation_class_path = "tree_models.Envy.Envy_simulation.EnvySimulation",
  branch_hierarchy = {},
  interactive = False,
  seed_value = None,
)

# Resolve extern-provided dotted paths so the rest of the script can operate on
# concrete classes/functions exactly like the Envy/UFO drivers do.

# Generator
lpy_rng = np.random.default_rng(seed=seed_value)

# Wood and simulation classes
#   Note that these will point to, eg, UFO or Envy, as specified in the extern paths

# Create instances of the simulation and trunk variables
SimulationConfigClass = resolve_attr(simulation_config_class_path)
SimulationClass = resolve_attr(simulation_class_path)
simulation_config = SimulationConfigClass(seed=seed_value)
tree_sim = SimulationClass(simulation_config)

prototype_builder_fn = resolve_attr(prototype_builder_path)
basicwood_prototypes = prototype_builder_fn(lpy_rng=lpy_rng, sim_config=simulation_config)
Trunk = resolve_attr(trunk_class_path)

# Create the main trunk
# TODO call as many times as there are trunks
# Create a growth guide curve for the initial trunk development
main_trunk = Trunk(basicwood_prototypes['trunk'])

# Build trellis geometry and attractor grids.
trellis_support = tree_sim.support

# Track parent/child relationships for tying/pruning decisions.
# Format: Name->list of bud children
branch_hierarchy["root"] = [main_trunk]
branch_hierarchy[main_trunk.name] = []
map_name_instance = {main_trunk.name: main_trunk}

# L-Py callbacks delegate to the Python helpers so architectures share logic.
def StartEach(lstring):
  """Proxy to shared tying preparation logic."""
  tree_sim.start_iteration(lstring, branch_hierarchy)


def EndEach(lstring):
  """Proxy to shared tying/pruning orchestration logic."""
  tree_sim.end_iteration(lstring, branch_hierarchy, getIterationNb)

# =============================================================================
# L-SYSTEM GRAMMAR DEFINITION
# =============================================================================
# This section defines the formal grammar for the tree growth simulation.
# The L-System uses modules (symbols) to represent different plant components
# and their growth behaviors.

# -----------------------------------------------------------------------------
# MODULE DECLARATIONS
# -----------------------------------------------------------------------------
# Define the vocabulary of symbols used in the L-System grammar.
# Each module represents a different type of plant component or operation.
# WoodStart and BudStart are markers in the string that are used in the "tie"  and
#  prune methods in the simulation to identify where to put the tying curve/prune
module Attractors     # Trellis support structure that guides branch growth
module grow_object(branch_name)    # Growing plant parts (trunk, branches, spurs) with length/thickness and hierarchy dict
module bud_site(branch_name)       # Adding a bud site along a branch
module bud_bud(bud_name)             # Dormant buds that can break to produce new branches with hierarchy dict
module add_branch(branch_name)     # Adds a trunk/branch
module add_spur(spur_name)         # Adds a spur
module BudStart(bud_name)         # Starting point of a bud
module WoodStart(branch_ptr, branch_name)     # Starting point of wood segments (used for tying operations)
module SpurStart(sour_name)         # Starting point of a spur
# Geometry creation - lower case are producers, upper case are production
module IStartBranch(branch_name)
module IMakeCylinders(branch_name, start_dist, end_dist, b_generate)
module IEndBranch(branch_name)
module make_cylinder(branch_name)
module make_bud_cylinder(bud_name)
module IStartBud(bud_name)
module IMakeBudCylinder(bud_name)
# -----------------------------------------------------------------------------
# GLOBAL L-SYSTEM PARAMETERS
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AXIOM (STARTING STRING)
# -----------------------------------------------------------------------------
# The initial L-System string that begins the simulation.
# Starts with the trellis attractors, sets up the trunk guide curve,
# and initializes the trunk growth with proper orientation and hierarchy dict.
#  Pitches the trunk left/right in the plane of growth (i.e., changes x, not y)
Axiom: Attractors(trellis_support)^(main_trunk.angle_wrt_ground())add_branch(main_trunk.name)

# -----------------------------------------------------------------------------
# DERIVATION PARAMETERS
# -----------------------------------------------------------------------------
# Set the maximum number of derivation steps for the L-System
derivation length: simulation_config.derivation_length

# -----------------------------------------------------------------------------
# PRODUCTION RULES
# -----------------------------------------------------------------------------
# Define how each module type evolves during each derivation step.
# These rules control the growth, branching, and development of the tree.

production:

make_cylinder(branch_name):
  branch = map_name_instance[branch_name]
  if tree_sim.generate_geometry:
    produce IMakeCylinders(branch_name, 0, branch.growth.length, True)
  else:
    nproduce make_cylinder(branch_name)

make_bud_cylinder(bud_name):
  bud = map_name_instance[bud_name]
  if tree_sim.generate_geometry:
    produce IMakeBudCylinder(bud_name)
  else:
    produce make_bud_cylinder(bud_name)

# Put a branch/trunk in the string
add_branch(branch_name):
  branch = map_name_instance[branch_name]
  nproduce[
  # This just places a marker in the string so we can cut it out later when pruning/adding a guide curve
  nproduce WoodStart(ParameterSet(type=branch, name=branch.name))
  # Set the positions and vectors - needs to be in the interpretation model, not here
  nproduce IStartBranch(branch_name)
  nproduce [
  # Put in square brackets so the turtle resets correctly
  nproduce make_cylinder(branch_name)
  nproduce ]
  # This is the main recursive call; it will keep calling itself until the max branch length is reached
  nproduce grow_object(branch_name)
  # This is suppose to capture the end location of the branch; warning that it's not always accurate
  nproduce IEndBranch(branch_name)
  produce]

# Put a spur in the string - similar to add_branch, but no need to edit
add_spur(spur_name):
  spur = map_name_instance[spur_name]
  nproduce[
  # Mark the point in the spur
  nproduce SpurStart(spur_name)
  # Set the positions and vectors - needs to be in the interpretation model, not here
  nproduce IStartBranch(spur_name)
  nproduce [
  # Put in square brackets so the turtle resets correctly
  nproduce make_cylinder(spur_name)
  nproduce ]
  # This is the main recursive call; it will keep calling itself until the max branch length is reached
  nproduce grow_object(spur_name)
  # This is suppose to capture the end location of the branch; warning that it's not always accurate
  nproduce IEndBranch(spur_name)
  produce]

# BUD PRODUCTION RULE
# Controls bud break and branch initiation
# Determines when buds activate to produce new branches
bud_bud(bud_name):
  if tree_sim.end_bud_growth:
    produce *
  bud = map_name_instance[bud_name]
  if not bud.is_bud_break():
    # Didn't break - leave the bud site here
    produce bud_bud(bud_name)
  # Bud break condition met - create new branch and/or spur
  new_branch = bud.create_branch()
  new_spur = bud.create_spur()
  if new_branch is None and new_spur is None:
      # Branch creation failed - terminate (this should not happen)
      print(f"base_lpy Error: Bud {bud_name} no new branch or spur")
      produce *
  # The orientation is 90 degrees until we know what the branch type is; this rotates back
  nproduce &(90 - bud.bud_angle_from_parent)
  # Register new branch and/or spur in parent-child relationship tracking
  if new_branch is not None:
    branch_hierarchy[new_branch.name] = []  # Initialize empty children list for new branch
    branch_hierarchy[bud.name].append(new_branch)  # Add to parent's children
    map_name_instance[new_branch.name] = new_branch  # Name to instance
    # All the lpy stuff
    nproduce add_branch(new_branch.name)
  if new_spur is not None:
    branch_hierarchy[new_spur.name] = []  # Initialize empty children list for new branch
    branch_hierarchy[bud.name].append(new_spur)  # Add to parent's children
    map_name_instance[new_spur.name] = new_spur  # Name to instance
    # All the lpy stuff
    nproduce add_spur(new_spur.name)

# BUD SITE PRODUCTION RULE
# Controls placing bud sites along a branch
# See bud_break below for when a bud actually transitions into branch or spur
bud_site(branch_name):
  # Bud break condition met - create new bud
  parent_branch = map_name_instance[branch_name]
  dist_last_bud = parent_branch.dist_last_bud()
  new_bud = parent_branch.add_bud_site()
  if new_bud == None:
    # Bud creation failed - terminate - this shouldn't happen...
    produce *
  # Register new branch in parent-child relationship tracking
  branch_hierarchy[new_bud.name] = []  # Initialize empty children list for new branch
  branch_hierarchy[parent_branch.name].append(new_bud)  # Add to parent's children
  map_name_instance[new_bud.name] = new_bud
  # Put the bud in the string - Next iteration will determine if the bud produces a branch
  # This will create the cylinder that comes before the bud
  nproduce IMakeCylinders(parent_branch.name, dist_last_bud, new_bud.dist_along, False)
  nproduce[
  # This just places a marker in the string so we can cut it out later when pruning/adding a guide curve
  nproduce BudStart(ParameterSet(name=new_bud.name))
  # Change the angle
  nproduce /(new_bud.bud_angle_around)^(90)
  # This gets the bud location information and creates the cylinder
  nproduce [
  nproduce IStartBud(new_bud.name)
  nproduce make_bud_cylinder(new_bud.name)
  nproduce ]
  # This is the call that will see if we need to bud
  nproduce bud_bud(new_bud.name)
  produce ]


# GROWTH PRODUCTION RULE
# Handles: growing the branch length
#  1) Adding buds
#  2) Adding
grow_object(branch_name):
  # Quit calling grow
  if tree_sim.end_growth:
    nproduce *
  branch = map_name_instance[branch_name]
  if branch.growth.length > 1.1 * branch.growth.prune_length:
    # Maximum length reached - stop growing this segment. Will be pruned anyways
    nproduce *
  else:
    # Continue growing - update segment properties
    # Update internal state of the plant segment
    branch.grow()
    # Update physical representation
    # Produce bud (after all cylinders in this growth step)
    for generated in branch.pre_bud_rule():
      nproduce new(generated[0], *generated[1])
    if branch.is_add_bud_site():
        nproduce bud_site(branch_name)
        for generated in branch.post_bud_rule():
          nproduce new(generated[0], *generated[1])
  # Continue growing
  produce grow_object(branch_name)


# -----------------------------------------------------------------------------
# GEOMETRIC INTERPRETATION (HOMOMORPHISM)
#  This only gets called in the interpolation step (called in tree builder) to create
#  geometry. So you will not see F's in the string when you print it out
#  Note: Not using generalized cylinders because we are going to manually stitch the
#   mesh cylinders together anyways. We do want to control the tapering and the
#   step size along the cylinders
# -----------------------------------------------------------------------------
interpretation:

IStartBranch(branch_name):
  # These grab the current turtle position and heading; for use in tie downs
  branch = map_name_instance[branch_name]
  nproduce GetPos(branch.location.start)
  nproduce GetHead(branch.location.start_dir)
  nproduce GetLeft(branch.location.start_left_dir)
  # TODO make this be treenamingconv
  r, g, b = color_manager.get_unique_color(branch.name)
  nproduce SetColor(r, g, b)
  contour = branch.contour_curve()
  if contour is not None:
    nproduce SetContour(contour)
  if branch.growth_curve:
    nproduce SetGuide(branch.growth_curve, branch.growth.prune_length)

IEndBranch(branch_name):
  branch = map_name_instance[branch_name]
  nproduce GetPos(branch.location.end)
  nproduce GetHead(branch.location.end_dir)
  nproduce GetLeft(branch.location.end_left_dir)

IMakeCylinders(branch_name, start_dist, end_dist, b_generate):
  branch = map_name_instance[branch_name]
  growth_length = end_dist - start_dist
  start_diameter = branch.growth.get_diameter(start_dist / branch.growth.length)
  end_diameter = branch.growth.get_diameter(end_dist / branch.growth.length)
  n_cylinders = int(growth_length / tree_sim.config.cylinder_length)
  if n_cylinders < 1:
    n_cylinders = 1
  step_along = growth_length / n_cylinders
  delta_t = 1.0 / n_cylinders
  # At each cylinder, advance the turtle along step_along and change the diameter
  for i in range(n_cylinders):
    t = i * delta_t
    if b_generate:
      diameter = (1.0 - t) * start_diameter + t * end_diameter
      if diameter <= 0.0:
        print(f"Bad diameter {branch_name} {diameter}")
      nproduce _(diameter) F(step_along)
    else:
      if growth_length <= 0.0:
        print(f"Bad growth length {branch_name} {growth_length}")
      nproduce f(growth_length)


IStartBud(bud_name):
  bud = map_name_instance[bud_name]
  nproduce EndGuide
  nproduce GetPos(bud.start_loc)
  nproduce GetHead(bud.start_dir)
  r, g, b = color_manager.get_unique_color(bud.name)
  nproduce SetColor(r, g, b)


IMakeBudCylinder(bud_name):
  bud = map_name_instance[bud_name]
  if bud.start_diameter() <= 0.0 or bud.end_diameter() <= 0.0:
    print(f"Bad bud {bud_name} {bud.start_diameter()}, {bud.end_diameter()}")
  nproduce _(bud.start_diameter())
  nproduce F(bud.draw_length(), bud.end_diameter())

# -----------------------------------------------------------------------------
# ATTRACTOR VISUALIZATION
# -----------------------------------------------------------------------------
# Additional production rules for displaying trellis attractor points
production:
Attractors(trellis_support):
  # Display enabled attractor points as visual markers
  trellis_support.check_valid()
  points_to_display = trellis_support.attractor_grid.get_enabled_points()
  if interactive and len(points_to_display) > 0:
    produce [,(3) @g(PointSet(points_to_display,width=simulation_config.attractor_point_width))]

