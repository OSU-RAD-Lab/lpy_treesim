from pathlib import Path
from openalea.lpy import *
from lpy_treesim import ColorManager

BASE_LPY_PATH = Path(__file__).resolve().parents[2] / "base_lpy.lpy"

color_manager = ColorManager()

vars = {
    "prototype_dict_path": "tree_models.Envy.Envy_prototypes.basicwood_prototypes",
    "trunk_class_path": "tree_models.Envy.Envy_prototypes.Trunk",
    "simulation_config_class_path": "tree_models.Envy.Envy_simulation.EnvySimulationConfig",
    "simulation_class_path": "tree_models.Envy.Envy_simulation.EnvySimulation",
    "color_manager": color_manager,
}

lsystem = Lsystem(str(BASE_LPY_PATH), vars)

for lstring in lsystem:
    lsystem.plot(lstring)
